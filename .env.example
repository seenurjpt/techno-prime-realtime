# MongoDB Atlas connection string (free tier works). Atlas clusters are replica sets, which realtime updates need.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/techno_prime

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Seeded admin account
ADMIN_EMAIL=admin@technoprime.dev
ADMIN_PASSWORD=Admin@123
